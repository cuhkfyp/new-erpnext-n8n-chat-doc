   "fieldname": "enabled",
   "fieldtype": "Check",
   "label": "Enabled"
  },
  {
   "fieldname": "configuration_section",
   "fieldtype": "Section Break",
   "label": "Environment Configuration"
  },
  {
   "description": "Non-secret namespace unique to this environment, for example example-prod. site_config.json ai_assistant_site_id takes precedence.",
   "fieldname": "site_identifier",
   "fieldtype": "Data",
   "label": "Site Identifier"
  },
  {
   "description": "Same-origin browser path only. site_config.json ai_assistant_webhook_url takes precedence.",
   "fieldname": "webhook_url",
   "fieldtype": "Data",
   "label": "Webhook URL"
  },
  {
   "fieldname": "column_break_configuration",
   "fieldtype": "Column Break"
  },
  {
   "description": "Internal n8n schema-sync webhook. site_config.json ai_assistant_sync_url takes precedence.",
   "fieldname": "schema_sync_url",
   "fieldtype": "Data",
   "label": "Schema Sync URL"
  },
  {
   "description": "Shared only with the matching n8n Header Auth credential. Frappe stores Password fields encrypted.",
   "fieldname": "integration_secret",
   "fieldtype": "Password",
   "label": "Integration Secret"
  },
  {
   "fieldname": "query_limits_section",
   "fieldtype": "Section Break",
   "label": "Permissioned Query Limits"
  },
  {
   "default": "20",
