   "description": "Hard application ceiling is 100.",
   "fieldname": "maximum_result_limit",
   "fieldtype": "Int",
   "label": "Maximum Result Limit",
   "reqd": 1
  },
  {
   "fieldname": "allowlist_section",
   "fieldtype": "Section Break",
   "label": "Schema DocType Allowlist"
  },
  {
