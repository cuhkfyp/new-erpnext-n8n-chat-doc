        "id": "fetch-existing-hashes",
        "name": "Fetch Existing Chunk Hashes",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "position": [-590, -100],
        "alwaysOutputData": true,
        "onError": "continueErrorOutput",
        "credentials": {
          "supabaseApi": { "id": "CONFIGURE_SUPABASE_CREDENTIAL", "name": "Supabase Schema RAG v2 - ENV" }
        }
      },
      {
        "parameters": {
          "jsCode": "const catalog = $('Fetch Schema-only Catalog').first().json.message;\nconst raw = $input.all().flatMap((item) => {\n  if (Array.isArray(item.json)) return item.json;\n  if (Array.isArray(item.json.body)) return item.json.body;\n  return item.json && item.json.doctype ? [item.json] : [];\n});\nconst existing = new Map(raw.map((row) => [`${row.doctype}\\u0000${row.chunk_id}`, row.content_hash]));\nconst desired = catalog.doctypes.flatMap((entry) => entry.chunks.map((chunk) => ({ site_id: catalog.site_id, doctype: entry.doctype, ...chunk })));\nconst desiredKeys = new Set(desired.map((chunk) => `${chunk.doctype}\\u0000${chunk.chunk_id}`));\nconst changed = desired.filter((chunk) => existing.get(`${chunk.doctype}\\u0000${chunk.chunk_id}`) !== chunk.content_hash);\nconst deleted = raw.filter((row) => !desiredKeys.has(`${row.doctype}\\u0000${row.chunk_id}`)).map((row) => ({ doctype: row.doctype, chunk_id: row.chunk_id }));\nreturn [{ json: { catalog, changed, deleted, hasChanges: changed.length ? 'yes' : 'no' } }];"
        },
        "id": "compare-catalog",
        "name": "Compare Deterministic Hashes",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [-350, -100]
      },
      {
        "parameters": {
          "conditions": {
            "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 2 },
            "conditions": [
              {
                "id": "changed-condition",
                "leftValue": "={{ $json.hasChanges }}",
                "rightValue": "yes",
                "operator": { "type": "string", "operation": "equals" }
