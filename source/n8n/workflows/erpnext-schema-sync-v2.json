      {
        "parameters": {
          "method": "POST",
          "url": "={{ $env.AI_SUPABASE_URL + '/rest/v1/rpc/list_erpnext_schema_hashes_v2' }}",
          "authentication": "predefinedCredentialType",
          "nodeCredentialType": "supabaseApi",
          "sendBody": true,
          "contentType": "raw",
          "rawContentType": "application/json",
          "body": "={{ JSON.stringify({ requested_site_id: $('Fetch Schema-only Catalog').first().json.message.site_id }) }}",
          "options": {}
