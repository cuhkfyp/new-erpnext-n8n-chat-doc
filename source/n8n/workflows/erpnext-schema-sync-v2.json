      {
        "parameters": {
          "method": "POST",
          "url": "={{ 'https://generativelanguage.googleapis.com/v1beta/models/' + $env.AI_EMBEDDING_MODEL + ':embedContent' }}",
          "authentication": "predefinedCredentialType",
          "nodeCredentialType": "googlePalmApi",
          "sendBody": true,
          "contentType": "raw",
          "rawContentType": "application/json",
          "body": "={{ JSON.stringify({ model: 'models/' + $env.AI_EMBEDDING_MODEL, content: { parts: [{ text: 'title: ' + $json.doctype + ':' + $json.chunk_id + ' | text: ' + $json.content }] }, output_dimensionality: Number($env.AI_EMBEDDING_DIMENSIONS || 768) }) }}",
          "options": {
            "response": { "response": { "fullResponse": true, "neverError": true, "responseFormat": "autodetect" } }
          }
        },
        "id": "embed-changed",
        "name": "Embed Changed Chunks at 768",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "position": [370, -220],
        "onError": "continueRegularOutput",
        "credentials": {
          "googlePalmApi": { "id": "CONFIGURE_EMBEDDING_CREDENTIAL", "name": "Gemini Embedding v2 - ENV" }
        }
      },
      {
        "parameters": {
          "mode": "runOnceForAllItems",
          "jsCode": "const responses = $input.all();\nconst source = $('Changed Schema Chunks').all().map((item) => item.json);\nconst embedded = [];\nconst errors = [];\nfor (let index = 0; index < source.length; index++) {\n  const response = responses[index]?.json || {};\n  const status = Number(response.statusCode || 200);\n  const body = response.body || response;\n  const values = body?.embeddings?.[0]?.values || body?.embedding?.values;\n  if (status < 200 || status >= 300 || !Array.isArray(values) || values.length !== Number($env.AI_EMBEDDING_DIMENSIONS || 768)) {\n    errors.push(`${source[index].doctype}/${source[index].chunk_id}: embedding failed (${status})`);\n    continue;\n  }\n  embedded.push({ ...source[index], embedding: values, embedding_model: $env.AI_EMBEDDING_MODEL });\n}\nreturn [{ json: { route: errors.length ? 'error' : 'ok', error: errors.join('; ').slice(0, 4000), chunks: embedded } }];"
        },
