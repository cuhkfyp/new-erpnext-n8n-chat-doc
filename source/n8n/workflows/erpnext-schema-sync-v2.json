      {
        "parameters": {
          "jsCode": "const comparison = $('Compare Deterministic Hashes').first().json;\nconst changedCount = comparison.changed.length;\nconst deletedCount = comparison.deleted.length;\nreturn [{ json: { result: { status: changedCount || deletedCount ? 'Drift' : 'Success', catalog_hash: comparison.catalog.catalog_hash, doctype_count: comparison.catalog.doctype_count, chunk_count: comparison.catalog.chunk_count, changed_count: changedCount, deleted_count: deletedCount, error: '' } } }];"
        },
        "id": "build-success",
        "name": "Build Successful Sync Result",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [3010, 40]
      },
      {
        "parameters": {
          "jsCode": "let catalog = {};\nlet comparison = { changed: [], deleted: [] };\ntry { catalog = $('Fetch Schema-only Catalog').first().json.message || {}; } catch {}\ntry { comparison = $('Compare Deterministic Hashes').first().json || comparison; } catch {}\nconst rawError = $json.error || (typeof $json.message === 'string' ? $json.message : '') || '';\nlet error = typeof rawError === 'object' ? (rawError.message || JSON.stringify(rawError)) : String(rawError);\nif (!catalog.complete && Array.isArray(catalog.errors)) error = `Catalog incomplete: ${catalog.errors.map((entry) => `${entry.doctype}: ${entry.error}`).join('; ')}`;\nreturn [{ json: { result: { status: 'Error', catalog_hash: catalog.catalog_hash || '', doctype_count: catalog.doctype_count || 0, chunk_count: catalog.chunk_count || 0, changed_count: comparison.changed?.length || 0, deleted_count: 0, error: String(error || 'Schema synchronization failed before completion').slice(0, 4000) } } }];"
        },
