# Non-secret production runtime values for ERPNext AI Assistant v2.
# n8n service credentials remain encrypted in n8n and do not belong here.
AI_ENVIRONMENT=production
AI_FRAPPE_BASE_URL=http://frappe-frontend:8080
AI_FRAPPE_SITE_HOST=frontend
AI_SUPABASE_URL=https://replace-with-production-project.supabase.co
AI_EMBEDDING_MODEL=gemini-embedding-2
AI_EMBEDDING_DIMENSIONS=768
AI_GENERATIVE_MODEL=gemini-2.5-flash
AI_SCHEMA_MATCH_COUNT=8
